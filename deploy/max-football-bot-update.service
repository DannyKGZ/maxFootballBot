# Автодеплой: проверка новых коммитов в GitHub и обновление бота (запускается таймером).
[Unit]
Description=MAX football bot — автообновление из GitHub
After=network-online.target
Wants=network-online.target
ConditionPathIsExecutable=/usr/local/libexec/max-football-bot/update.sh

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/max-football-bot/update.sh --auto
TimeoutStartSec=30min
