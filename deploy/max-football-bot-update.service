# Автодеплой: проверка новых коммитов в GitHub и обновление бота (запускается таймером).
[Unit]
Description=MAX football bot — автообновление из GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/max-football-bot/deploy/auto-update.sh
TimeoutStartSec=15min
