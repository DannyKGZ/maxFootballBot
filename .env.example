# Токен бота, выданный в настройках бота на platform.max.ru
BOT_TOKEN=your_bot_token_here

# ID чата, куда бот публикует запись на футбол (можно узнать из апдейта bot_started/message_created)
CHAT_ID=123456789

# Как бот получает сообщения из MAX:
#   webhook — MAX шлёт их на PUBLIC_WEBHOOK_URL (нужен HTTPS: туннель или домен) — для запуска на ПК;
#   polling — бот сам забирает их (GET /updates), не нужны ни домен, ни туннель — для сервера.
UPDATES_MODE=webhook

# Порт, на котором поднимается HTTPS/HTTP сервер вебхука
PORT=443

# Публичный HTTPS-адрес вебхука, который будет зарегистрирован в MAX (POST /subscriptions)
PUBLIC_WEBHOOK_URL=https://your-domain.example.com/webhook

# Секрет для проверки заголовка X-Max-Bot-Api-Secret (5-256 символов, буквы/цифры/дефис)
WEBHOOK_SECRET=change_me_please

# Если true — при старте бот сам вызовет POST /subscriptions с PUBLIC_WEBHOOK_URL
AUTO_REGISTER_WEBHOOK=false

# Пути к TLS-сертификату и ключу. Если не заданы — сервер поднимается по HTTP
# (используйте этот вариант, если TLS терминируется на nginx/Caddy/Traefik перед ботом).
# Начиная с 25 мая 2026 MAX принимает только сертификаты Минцифры или доверенного центра —
# самоподписанные сертификаты больше не работают.
TLS_CERT_PATH=
TLS_KEY_PATH=

# Часовой пояс для планировщика и форматирования дат
TIMEZONE=Europe/Moscow

# Cron-расписание публикации записи (по умолчанию: пн и пт в 9:00)
CRON_SCHEDULE=0 9 * * 1,5

# День недели игры: 0=вс, 1=пн, 2=вт, 3=ср, 4=чт, 5=пт, 6=сб
GAME_DAY_OF_WEEK=3

# Время начала игры (используется и в тексте сообщения, и для даты сессии)
GAME_TIME=21:30

# Максимум мест в основном составе (дальше — резерв)
MAX_PLAYERS=10


# Лимиты для "+Имя +Имя": сколько имён за одно сообщение и максимальная длина имени
MAX_NAMES_PER_MESSAGE=5
MAX_NAME_LENGTH=30

# Через сколько минут бот забывает неотвеченный вопрос ("Да/Нет", "напишите имя")
PENDING_TTL_MINUTES=15

# Напоминание в чат за N часов до игры (0 — выключено)
REMINDER_HOURS_BEFORE=5

# Голосование за MVP закрывается само через N часов после старта (0 — только вручную /итоги)
VOTE_AUTO_CLOSE_HOURS=24

# База SQLite со всем состоянием бота. Старые data/*.json переносятся в неё
# автоматически при первом запуске (и переименовываются в *.json.migrated).
DB_FILE=./data/bot.db

# Напоминание об оплате игрокам основы — отдельным сообщением с упоминаниями,
# каждый час за PAYMENT_HOURS_BEFORE ч до игры и PAYMENT_HOURS_AFTER ч после (0 — выкл.)
PAYMENT_AMOUNT=350
PAYMENT_DETAILS=💳 Сбер 0000000000
PAYMENT_HOURS_BEFORE=3
PAYMENT_HOURS_AFTER=2

# Объявление /Всем (@all) дублировать каждому участнику в личку (true — включить;
# доходит только тем, кто хоть раз открывал бота)
ANNOUNCE_DM=false
